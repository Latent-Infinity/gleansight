# Semantic Scholar API key (optional)
# Increases rate limits from 10 req/s to 100 req/s
# Get your key at: https://www.semanticscholar.org/product/api#api-key
SEMANTIC_SCHOLAR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Unpaywall API email (optional)
# Required for DOI-based PDF resolution via Unpaywall
# More info: https://unpaywall.org/products/api
UNPAYWALL_EMAIL=your@email.com
